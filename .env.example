# Caminho absoluto para o repositório git local que será analisado.
REPO_PATH=/path/to/your/repo

# E-mail do autor cujos commits serão coletados.
AUTHOR_EMAIL=you@example.com

# Data inicial da coleta de commits (formato YYYY-MM-DD).
SINCE_DATE=2026-01-01

# ID da planilha do Google Sheets (encontrado na URL da planilha).
GOOGLE_SHEET_ID=your-google-sheet-id

# Modelo Gemini a ser usado (opcional).
# GEMINI_MODEL=gemini-3-flash-preview

# Modo de execução: defina como "development" para usar os mocks
# em sdk/data/ ao invés de chamar a LLM de verdade.
# MODE=development
